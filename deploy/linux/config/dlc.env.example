# Copy to /etc/dalu-parts/dlc.env and replace every CHANGE_ME value.
# Keep this file readable only by root (mode 0600).
APP_ENV=production
HTTP_ADDR=127.0.0.1:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dlc_app
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_NAME=dl_nongji_parts

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AUTH_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES

CORS_ALLOWED_ORIGINS=https://www.example.cn
TRUSTED_PROXY_CIDRS=127.0.0.1,::1
PUBLIC_DIR=/opt/dalu-parts/public
MEDIA_DIR=/var/lib/dalu-parts/media_storage

# Production migrations are always run explicitly with /opt/dalu-parts/initdb.
RUN_MIGRATIONS=false
SEED_DEMO_DATA=false

BAIDU_PUSH_TOKEN=
GEOIP_DB_PATH=

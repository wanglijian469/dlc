# 生产环境模板：先替换域名、数据库凭据、管理员密码和随机密钥。
APP_ENV=production
HTTP_ADDR=:8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dlc_app
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_NAME=dl_nongji_parts
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
CORS_ALLOWED_ORIGINS=https://www.example.cn
PUBLIC_DIR=./public
MEDIA_DIR=./media_storage

# 只信任云网关/CDN回源网段；不得填写 0.0.0.0/0。
TRUSTED_PROXY_CIDRS=127.0.0.1

# 生产应用进程不自动改表。发布前单独执行 server.exe 对应的 initdb 命令。
RUN_MIGRATIONS=false
SEED_DEMO_DATA=false

# 可选配置，默认关闭。
BAIDU_PUSH_TOKEN=
GEOIP_DB_PATH=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DLC shared enums",
  "$defs": {
    "AccountRole": { "enum": ["admin", "editor", "reviewer", "vendor", "buyer"] },
    "AuctionStatus": { "enum": ["draft", "open", "awaiting_award", "awarded", "unawarded", "cancelled", "suspended"] },
    "VendorPostStatus": { "enum": ["draft", "pending", "approved", "rejected", "withdrawn"] }
  }
}
